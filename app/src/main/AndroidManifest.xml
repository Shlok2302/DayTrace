<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Internet permission (Gemini summary) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reminders and processing updates (asked for at runtime on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reminders on the minute; the user allows it under "Alarms & reminders" -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Alarms are cleared on restart, so the reminders are set again -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DayTraceApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Voice Recorder"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceRecorder">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".service.RecordingService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

        <!-- A reminder going off, and its "Done" / "Not yet" buttons -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!--
            Sets the reminders again after a restart, an app update, a time
            change, or when exact alarms are allowed. Exported only because
            these broadcasts come from the system; all of them are protected.
        -->
        <receiver
            android:name=".reminders.RescheduleReceiver"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>

        </receiver>

        <!--
            New notes were saved: if Google Calendar is connected, look for
            events in them (only a suggestion; nothing is added by itself).
            The broadcast is sent inside the app only.
        -->
        <receiver
            android:name=".google.calendar.NewNotesReceiver"
            android:exported="false">

            <intent-filter>
                <action android:name="com.example.voicerecorder.SUMMARY_COMPLETE" />
            </intent-filter>

        </receiver>

        <!-- Starts the Gemini summary after RecordingService saves an MP3 -->
        <receiver
            android:name=".summary.RecordingCompleteReceiver"
            android:exported="false">

            <intent-filter>
                <action android:name="com.example.voicerecorder.RECORDING_COMPLETE" />
            </intent-filter>

        </receiver>

    </application>

</manifest>