<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground service permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Internet permission (Gemini summary) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DayTraceApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Voice Recorder"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceRecorder">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <service
            android:name=".service.RecordingService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

        <!-- Starts the Gemini summary after RecordingService saves an MP3 -->
        <receiver
            android:name=".summary.RecordingCompleteReceiver"
            android:exported="false">

            <intent-filter>
                <action android:name="com.example.voicerecorder.RECORDING_COMPLETE" />
            </intent-filter>

        </receiver>

    </application>

</manifest>