<?xml version="1.0" encoding="utf-8"?>
<!--
    Edit the event before it is added to Google Calendar (ui/CalendarFlow.kt).
    The same card, fonts and buttons as the DayTrace dialog.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="18dp"
    android:paddingVertical="24dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:elevation="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_forest_soft">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit"
                            android:importantForAccessibility="no"
                            android:contentDescription="@null"
                            app:tint="@color/forest" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="@string/calendar_edit_title"
                        style="@style/Text.Title"
                        android:textSize="22sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/calendar_field_title"
                    style="@style/Text.Label"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/inputTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="52dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:importantForAutofill="no"
                    android:hint="@string/calendar_field_title_hint"
                    android:textColorHint="@color/text_tertiary"
                    style="@style/Text.BodyStrong" />

                <include
                    android:id="@+id/rowDate"
                    layout="@layout/item_editor_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <include
                    android:id="@+id/rowAllDay"
                    layout="@layout/item_editor_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <include
                    android:id="@+id/rowStart"
                    layout="@layout/item_editor_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <include
                    android:id="@+id/rowEnd"
                    layout="@layout/item_editor_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/calendar_field_location"
                    style="@style/Text.Label"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/inputLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="52dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:inputType="textCapWords"
                    android:maxLines="2"
                    android:importantForAutofill="no"
                    android:hint="@string/calendar_field_location_hint"
                    android:textColorHint="@color/text_tertiary"
                    style="@style/Text.BodyStrong" />

                <include
                    android:id="@+id/rowCalendar"
                    layout="@layout/item_editor_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <include
                    android:id="@+id/rowReminder"
                    layout="@layout/item_editor_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCancel"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/bg_button_outline"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/cancel"
                        android:textColor="@color/forest"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnSave"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:background="@drawable/bg_button_forest"
                        android:foreground="?attr/selectableItemBackground"
                        android:text="@string/calendar_edit_done"
                        android:textColor="@color/on_forest"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</FrameLayout>
