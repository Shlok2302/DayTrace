<?xml version="1.0" encoding="utf-8"?>
<!-- One choice in a DayTrace dialog list: optional icon, label, optional detail, and a check or chevron. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_dialog_choice"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingVertical="12dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/iconHolder"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_circle_forest_soft"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:contentDescription="@null"
            app:tint="@color/forest" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.BodyStrong"
            android:lineSpacingExtra="0sp" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/Text.Label"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

</LinearLayout>
