<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Same theme as by day, on the dark Material parent so that dialogs
        and menus come out dark too. The colours themselves come from
        values-night/colors.xml.
    -->
    <style name="Theme.VoiceRecorder" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryVariant">@color/forest_dark</item>
        <item name="colorOnPrimary">@color/on_forest</item>
        <item name="colorSecondary">@color/forest</item>
        <item name="colorSecondaryVariant">@color/forest_dark</item>
        <item name="colorOnSecondary">@color/on_forest</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
